# Copy file này thành .env (cùng thư mục gốc repo) rồi điền giá trị thật.
# .env đã nằm trong .gitignore nên không bao giờ bị commit.
#
# Backend đọc file này qua spring.config.import trong application.yaml.
# Frontend đọc qua envDir trong vite.config.ts — nhưng CHỈ các biến có tiền tố
# VITE_, nên secret bên dưới không lọt vào bundle của trình duyệt.
#
# Cú pháp là KEY=VALUE, không có dấu nháy, không có khoảng trắng quanh dấu =.
# Vì Spring đọc file này như .properties nên dấu backslash là ký tự escape:
# nếu giá trị có dấu \ thì phải viết thành \\.

# ---------- Backend ----------

# Mật khẩu tài khoản PostgreSQL bạn dùng để kết nối (mặc định username là postgres).
DB_PASSWORD=

# Mật khẩu và email cho tài khoản quản trị ĐẦU TIÊN, chỉ dùng khi bảng users
# còn rỗng. Thiếu một trong hai trên một CSDL rỗng thì backend dừng ngay lúc
# khởi động và nói rõ thiếu biến nào.
# Tài khoản tạo ra bị bắt đổi mật khẩu ở lần đăng nhập đầu.
# Email là bắt buộc vì OTP quên mật khẩu chỉ gửi qua email.
RIMS_ADMIN_PASSWORD=
RIMS_ADMIN_EMAIL=

# Gửi email OTP. Ứng dụng gửi qua HTTP API của Brevo (cổng 443), KHÔNG qua SMTP
# — nhiều nền tảng lưu trữ chặn cổng SMTP đi ra nên SMTP không dùng được khi
# deploy. Thiếu một trong hai biến này là app không khởi động được.
#
# BREVO_API_KEY   : Brevo > SMTP & API > API Keys
# MAIL_FROM_EMAIL : địa chỉ đứng tên gửi, phải XÁC MINH trước ở
#                   Brevo > Senders, Domains & Dedicated IPs > Senders.
#                   Không cần sở hữu tên miền — địa chỉ Gmail dùng được.
BREVO_API_KEY=
MAIL_FROM_EMAIL=

# Khoá ký JWT, tối thiểu 32 ký tự. Sinh chuỗi mới: openssl rand -base64 48
JWT_SIGNER_KEY=

# Khoá bí mật ký giao dịch, lấy trong tài khoản sandbox VNPay.
VNPAY_HASH_SECRET=

# ---------- Frontend ----------

# Địa chỉ backend để Vite proxy các request /rims và /ws-rims sang.
VITE_API_BASE_URL=http://localhost:8080

# ---------- KHÔNG đặt trong file này ----------
# FRONTEND_URL và VNPAY_RETURN_URL là cấu hình CỦA NƠI DEPLOY, không phải của
# máy phát triển. Đặt chúng trỏ sang tên miền thật ở đây sẽ làm hỏng chạy local:
# CorsConfig chỉ cho đúng MỘT origin, nên backend ở máy sẽ từ chối mọi request
# từ localhost:5173 với thông báo "Invalid CORS request".
#
# Khi chạy ở máy, cả hai tự rơi về localhost trong application.yaml. Khi deploy
# thì khai chúng trong bảng biến môi trường của nền tảng.
#
# Tương tự, đừng để DB_URL trỏ sang cơ sở dữ liệu thật: mỗi lần chạy
# ./mvnw spring-boot:run sẽ ghi thẳng vào dữ liệu production.

# ---------- Tuỳ chọn ----------
# Các biến dưới đây đã có giá trị mặc định trong application.yaml,
# chỉ cần khai báo khi muốn đổi.
#
# MAIL_FROM_NAME=RIMS
#
# SERVER_PORT=8080
# DB_URL=jdbc:postgresql://localhost:5432/rims_db
# DB_USERNAME=postgres
#
# Khi deploy lên CSDL có quản lý (Neon, Supabase, Render, RDS...), gần như luôn
# phải bật SSL, nếu không máy chủ từ chối kết nối:
# DB_URL=jdbc:postgresql://<host>:5432/<db>?sslmode=require
#
# FRONTEND_URL=http://localhost:5173
# VNPAY_TMN_CODE=
# VNPAY_RETURN_URL=http://localhost:8080/rims/cashier/payments/vnpay-callback
#
# Mật khẩu cấp cho tài khoản do Quản trị viên tạo, cho khách tự đăng ký, và cho
# tài khoản vừa được đặt lại. Không đặt thì dùng giá trị mặc định trong
# application.yaml — mà giá trị đó ai đọc repo cũng biết. Nên đặt khi chạy thật.
# RIMS_DEFAULT_PASSWORD=
#
# Tên đăng nhập / họ tên / điện thoại của tài khoản quản trị đầu tiên.
# (RIMS_ADMIN_EMAIL là bắt buộc, khai báo ở mục Backend phía trên.)
# RIMS_ADMIN_USERNAME=admin
# RIMS_ADMIN_FULL_NAME=Quản trị viên
# RIMS_ADMIN_PHONE=0900000001
#
# Nhận diện nhà hàng, chỉ dùng cho LẦN KHỞI ĐỘNG ĐẦU khi bảng restaurant_profile
# còn rỗng. Sau đó chủ quán sửa trong màn Cấu hình nhà hàng và CSDL là nguồn thật.
# RESTAURANT_NAME=Yamazato
# RESTAURANT_TAGLINE=Ẩm thực Nhật Bản
# RESTAURANT_DESCRIPTION=
# RESTAURANT_ADDRESS=
# RESTAURANT_PHONE=
# RESTAURANT_EMAIL=
#
# Bể kết nối. Giá trị mặc định đã hợp với CSDL kiểu serverless (Neon, Supabase).
# Chỉ đổi khi biết rõ đang làm gì.
# DB_POOL_MAX=5
# DB_POOL_MIN=0
# DB_CONNECTION_TIMEOUT=30000
#
# Lược đồ CSDL do schema.sql dựng, Hibernate chỉ đối chiếu (validate). Chỉ đổi
# hai biến này khi biết rõ đang làm gì.
# DDL_AUTO=validate
# SQL_INIT_MODE=always
